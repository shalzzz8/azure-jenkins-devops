pipeline {
    agent any

    environment {
        APP_NAME = 'devops-cicd-app'
        APP_PORT = '80'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('Checkout Source') {
            steps {
                echo "📥 Checking out latest source code from GitHub..."
                checkout scm
            }
        }

        stage('Test & Validate (CI)') {
            steps {
                echo "🧪 Running unit tests..."
                dir('app') {
                    sh '''
                        npm install
                        npm test
                    '''
                }
            }
        }

        stage('Build Docker Container') {
            steps {
                echo "🐳 Building Docker image..."
                sh '''
                    docker build -t ${APP_NAME}:latest app/
                '''
            }
        }

        stage('Deploy to Azure VM (CD)') {
            steps {
                echo "🚀 Deploying container on Azure VM (Port ${APP_PORT})..."
                sh '''
                    # Stop and remove existing container if running
                    docker stop ${APP_NAME} || true
                    docker rm ${APP_NAME} || true

                    # Run new container
                    docker run -d \
                      --name ${APP_NAME} \
                      --restart unless-stopped \
                      -p ${APP_PORT}:3000 \
                      ${APP_NAME}:latest
                '''
            }
        }

        stage('Smoke Test & Health Probe') {
            steps {
                echo "🏥 Verifying live deployment on Azure VM..."
                sh '''
                    sleep 3
                    curl --retry 5 --retry-delay 3 -f http://localhost:${APP_PORT}/health
                    echo ""
                    echo "✅ Smoke test passed! Application is live and healthy."
                '''
            }
        }
    }

    post {
        success {
            echo "=========================================================="
            echo "🎉 Continuous Deployment Succeeded!"
            echo "🌍 Live App is accessible on Azure at Port 80!"
            echo "=========================================================="
        }
        failure {
            echo "❌ Pipeline failed! Please review console logs."
        }
    }
}
